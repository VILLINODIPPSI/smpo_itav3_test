// **Profili dei membri del gruppo - Caricati dinamicamente da CSV**   
// Questo file carica i profili da profiles.csv invece di averli hard-coded
// Per modificare i profili, edita profiles.csv con Excel

// CACHE BUSTING: Aggiunge timestamp per forzare il reload del CSV
(function() {
    try {
        console.log('📥 Caricamento profiles.csv...');
        
        // Aggiungi timestamp per evitare cache
        var timestamp = new Date().getTime();
        var csvUrl = 'profiles.csv?v=' + timestamp;
        
        console.log('🔄 URL con cache busting:', csvUrl);
        
        // Usa XMLHttpRequest SINCRONO
        var xhr = new XMLHttpRequest();
        xhr.open('GET', csvUrl, false);  // false = sincrono
        xhr.send();
        
        if (xhr.status !== 200) {
            throw new Error('HTTP error! status: ' + xhr.status);
        }
        
        var csvText = xhr.responseText;
        
        // Parse CSV manualmente (gestisce virgolette e virgole nei testi)
        function parseCSV(text) {
            var lines = text.trim().split('\n');
            var profiles = [];
            
            for (var i = 1; i < lines.length; i++) {
                var line = lines[i];
                if (!line.trim()) continue;
                
                var values = [];
                var currentValue = '';
                var insideQuotes = false;
                
                // Parse carattere per carattere per gestire virgolette
                for (var j = 0; j < line.length; j++) {
                    var char = line[j];
                    
                    if (char === '"') {
                        insideQuotes = !insideQuotes;
                    } else if (char === ',' && !insideQuotes) {
                        values.push(currentValue.trim());
                        currentValue = '';
                    } else {
                        currentValue += char;
                    }
                }
                values.push(currentValue.trim());
                
                // Crea l'oggetto profilo
                if (values.length >= 4) {
                    var avatar = values[0];
                    var username = values[1];
                    var text = values[2];
                    var likesStr = values[3];
                    
                    // Parse array likes
                    var likesArray = likesStr.split(',');
                    var likes = [];
                    for (var k = 0; k < likesArray.length; k++) {
                        var num = parseInt(likesArray[k].trim());
                        if (!isNaN(num)) {
                            likes.push(num);
                        }
                    }
                    
                    profiles.push({
                        avatar: avatar,
                        username: username,
                        text: text,
                        likes: likes
                    });
                }
            }
            
            return profiles;
        }
        
        // Parse il CSV
        var profiles = parseCSV(csvText);
        
        // Popola window.others nel formato atteso
        window.others = {
            posts: profiles
        };
        
        console.log('✅ Profili caricati da CSV: ' + profiles.length + ' profili');
        console.log('📋 Profili:', profiles.map(function(p) { return p.username; }).join(', '));
        console.log('🕐 Timestamp cache busting:', timestamp);
        
    } catch (error) {
        console.error('❌ Errore durante il caricamento del CSV:', error);
        console.error('Assicurati che profiles.csv sia presente nella stessa directory');
        
        // Fallback: crea array vuoto
        window.others = {
            posts: []
        };
    }
})();

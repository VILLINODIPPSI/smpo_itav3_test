// **Profili dei membri del gruppo - Caricati dinamicamente da CSV**   
// Questo file carica i profili da profiles.csv invece di averli hard-coded
// Per modificare i profili, edita profiles.csv con Excel

(async function() {
    try {
        // Carica il file CSV
        const response = await fetch('profiles.csv');
        if (!response.ok) {
            throw new Error(`HTTP error! status: ${response.status}`);
        }
        const csvText = await response.text();
        
        // Parse CSV manualmente (gestisce virgolette e virgole nei testi)
        function parseCSV(text) {
            const lines = text.trim().split('\n');
            const headers = lines[0].split(',');
            const profiles = [];
            
            for (let i = 1; i < lines.length; i++) {
                const line = lines[i];
                if (!line.trim()) continue;
                
                const values = [];
                let currentValue = '';
                let insideQuotes = false;
                
                // Parse carattere per carattere per gestire virgolette
                for (let j = 0; j < line.length; j++) {
                    const char = line[j];
                    
                    if (char === '"') {
                        insideQuotes = !insideQuotes;
                    } else if (char === ',' && !insideQuotes) {
                        values.push(currentValue.trim());
                        currentValue = '';
                    } else {
                        currentValue += char;
                    }
                }
                // Aggiungi l'ultimo valore
                values.push(currentValue.trim());
                
                // Crea l'oggetto profilo
                if (values.length >= 4) {
                    const avatar = values[0];
                    const username = values[1];
                    const text = values[2];
                    const likesStr = values[3];
                    
                    // Parse array likes
                    const likes = likesStr.split(',').map(n => parseInt(n.trim())).filter(n => !isNaN(n));
                    
                    profiles.push({
                        avatar: avatar,
                        username: username,
                        text: text,
                        likes: likes
                    });
                }
            }
            
            return profiles;
        }
        
        // Parse il CSV
        const profiles = parseCSV(csvText);
        
        // Popola window.others nel formato atteso
        window.others = {
            posts: profiles
        };
        
        console.log(`✅ Profili caricati da CSV: ${profiles.length} profili`);
        console.log('📋 Profili:', profiles.map(p => p.username).join(', '));
        
        // Trigger evento per notificare che i dati sono pronti
        window.dispatchEvent(new Event('profilesLoaded'));
        
    } catch (error) {
        console.error('❌ Errore durante il caricamento del CSV:', error);
        console.error('Assicurati che profiles.csv sia presente nella stessa directory');
        
        // Fallback: crea un array vuoto per evitare errori
        window.others = {
            posts: []
        };
    }
})();
